{
  "name": "studygps",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic StudyGPS analysis engine and hosted demonstration",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-web.js",
    "build": "node engine/scripts/build-n8n.js --check && node scripts/build-web.js",
    "test": "node --test tests/*.test.js engine/tests/*.test.js",
    "demo": "node engine/scripts/demo.js",
    "db:migrate": "node --env-file=.env.local scripts/migrate-db.js",
    "demo:seed": "node --env-file=.env.local scripts/seed-classroom-demo.js",
    "build:cloudflare": "npm run build && node scripts/build-cloudflare.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@clerk/localizations": "4.16.1",
    "@neondatabase/serverless": "1.1.0"
  }
}
