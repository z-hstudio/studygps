# Obtain real values from the Clerk and Neon integrations. Never commit .env files.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
# Exact canonical frontend origin. Local development also permits port 3040.
APP_ORIGIN=https://studygps-five.vercel.app
# Optional operator-selected first administrator. Only Clerk's verified primary
# email is compared; never trust an email typed into a StudyGPS form.
STUDYGPS_ADMIN_EMAIL=
# Optional networkless JWT verification is not required by this implementation.
# Additional teacher privileges are provisioned through Clerk privateMetadata:
# { "studygpsRole": "teacher" }. New accounts always default to student.
